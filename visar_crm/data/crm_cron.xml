<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: el staff puede ajustar frecuencia/activo sin que un upgrade lo
         pise (mismo patron que el cron de visar_field_app). -->
    <data noupdate="1">
        <record id="visar_crm_expire_cron" model="ir.cron">
            <field name="name">Visar CRM: caducar leads de WhatsApp inactivos</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._visar_crm_expire_stale_leads()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
