<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- REQ-004: "Actualizar precios" siempre a mano, con aviso.

         Odoo solo muestra el botón justo después de cambiar la lista en el
         formulario (`show_update_pricelist` no se guarda): si se guarda la
         cotización antes de pulsarlo, desaparece y las líneas se quedan con el
         precio sin lista. Aquí queda visible mientras la cotización tenga lista y
         líneas, y el aviso dice lo que el nativo calla: también quita descuentos. -->
    <record id="view_order_form_visar_pricelist" model="ir.ui.view">
        <field name="name">sale.order.form.visar.pricelist</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_update_prices']" position="attributes">
                <attribute name="invisible">state in ['sale', 'cancel'] or not pricelist_id or not order_line</attribute>
                <attribute name="string">Actualizar precios</attribute>
                <attribute name="confirm">Se van a recalcular los precios unitarios de TODAS las líneas con la lista de precios seleccionada. Los descuentos y precios capturados a mano se reemplazan. ¿Continuar?</attribute>
            </xpath>
            <!-- La zona del CP de la dirección de entrega, para elegir la lista de
                 precios sin ir a buscar el CP a Citas. -->
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="visar_zone_id" options="{'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Pedidos históricos (27-oct-2026): la fecha de la orden se ve sin hora, y
         la de cotización ya no pide modo desarrollador, para poder capturar un
         pedido del pasado con su fecha antes de confirmarlo (al confirmar se
         respeta: ver `models/fecha_historica.py`). -->
    <record id="view_order_form_visar_fecha" model="ir.ui.view">
        <field name="name">sale.order.form.visar.fecha</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//group[@name='order_details']/div[label[@for='date_order']])[1]" position="attributes">
                <attribute name="groups"></attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='date_order'][1]" position="attributes">
                <attribute name="groups"></attribute>
                <attribute name="widget">date</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='date_order'][2]" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
        </field>
    </record>

</odoo>
