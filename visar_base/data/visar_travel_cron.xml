<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: el staff puede ajustar frecuencia/activo sin que un upgrade lo
         pise (mismo patrón que el cron de apartados de `visar_appointment`). -->
    <data noupdate="1">
        <record id="visar_travel_cache_gc_cron" model="ir.cron">
            <field name="name">Visar: limpiar caché de tiempos de viaje</field>
            <field name="model_id" ref="model_visar_travel_cache"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_gc()</field>
            <field name="user_id" ref="base.user_root"/>
            <!-- Solo evita que la tabla crezca: las lecturas YA filtran por
                 `fetched_at`, así que la corrección no depende de este cron.
                 Diario basta; no hay nada urgente que barrer. -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
