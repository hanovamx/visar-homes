<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Las tres plagas que la pregunta de la cita traía escritas en el código.
         Los códigos son los que ya guardan las reservas en `servicio_plaga`. -->
    <record id="plaga_rastreros" model="visar.plaga">
        <field name="name">Rastreros</field>
        <field name="description">Cucarachas, alacranes, hormigas, arañas</field>
        <field name="code">rastreros</field>
        <field name="sequence">10</field>
    </record>

    <record id="plaga_voladores" model="visar.plaga">
        <field name="name">Voladores</field>
        <field name="description">Moscas, mosquitos o zancudos</field>
        <field name="code">voladores</field>
        <field name="sequence">20</field>
    </record>

    <record id="plaga_roedores" model="visar.plaga">
        <field name="name">Roedores</field>
        <field name="description">Ratas y ratones</field>
        <field name="code">roedores</field>
        <field name="sequence">30</field>
    </record>

</odoo>
