<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================================================================
         Cascarón compartido del reporte para el CLIENTE.
         El logo y los datos de Visar los pone `web.external_layout` (compañía).
         Aquí se ajusta la fila superior (Cliente + Técnico) y se retiran los
         bloques de tiempo/costo INTERNOS que el cliente no debe ver.
         ================================================================ -->

    <!-- (1) Cliente y (2) Técnico. Reemplaza la fila nativa, que ponía el Técnico
         desde `user_ids` (VACÍO en técnicos de campo, sin usuario interno) y dejaba
         el bloque en blanco. Orden pedido por el cliente: primero Cliente, luego
         Técnico (nombre + teléfono, desde `visar_tech_map`). -->
    <template id="visar_worksheet_report_parties"
              inherit_id="industry_fsm.worksheet_custom_page" priority="98">
        <xpath expr="//div[@class='page']/div[@class='oe_structure']/following-sibling::div[1]"
               position="replace">
            <!-- Ajustes de tipografía/espaciado del cascarón, inyectados en el CUERPO
                 (el <style> del header viaja en un documento aislado y no aplica aquí):
                 · El external_layout pinta un <h2 t-out="layout_document_title"/> justo
                   antes de la ficha Cliente/Técnico; este reporte NO define ese título,
                   así que quedaba un H2 VACÍO enorme (mucho espacio en blanco). Se oculta.
                 · Se baja el tamaño del título del servicio ("Reporte de servicio
                   externo: S00134 - …"), que con h2 nativo se salía a 3+ líneas. -->
            <style>
                .o_report_layout_bold > h2, .o_report_layout_standard > h2 { display: none; }
                .o_visar_ws_service_title {
                    font-size: 19px; line-height: 1.25; margin: 4px 0 10px 0;
                }
            </style>
            <!-- margin-bottom amplio: separa la ficha Cliente/Técnico del título del
                 servicio (antes quedaban pegados). -->
            <div class="row" style="margin-bottom: 28px;">
                <div t-if="doc.partner_id"
                     t-att-class="'col-6' if report_type == 'pdf' else 'col-md-6 col-12'">
                    <div><strong>Cliente:</strong></div>
                    <div t-out="doc.partner_id" t-options='{
                        "widget": "contact",
                        "fields": ["name", "address", "phone", "email"]}'/>
                </div>
                <div t-att-class="'col-6' if report_type == 'pdf' else 'col-md-6 col-12'">
                    <div><strong>Técnico que realizó el servicio:</strong></div>
                    <t t-if="visar_tech_map and visar_tech_map.get(doc.id)">
                        <div t-foreach="visar_tech_map.get(doc.id)" t-as="tech"
                             t-key="tech_index" class="mb-1">
                            <div t-out="tech['name']"/>
                            <div t-if="tech['phone']">Tel.: <span t-out="tech['phone']"/></div>
                        </div>
                    </t>
                    <div t-else="">—</div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- (1b) Título del servicio ("Reporte de servicio externo: S00134 - …"). El
         nativo lo pinta como <h2> gigante que se salía a 3+ líneas. Se le pone una
         clase para bajarlo de tamaño (regla en el <style> de la ficha Cliente/Técnico),
         sin tocar el texto traducible ni `doc.name`. -->
    <template id="visar_worksheet_report_service_title"
              inherit_id="industry_fsm.worksheet_custom_page" priority="98">
        <xpath expr="//span/t[@t-if='doc.name']/h2" position="attributes">
            <attribute name="class">o_visar_ws_service_title</attribute>
        </xpath>
    </template>

    <!-- (4, parte interna) Se retiran del reporte del cliente los registros de
         tiempo/costo INTERNOS: "Registro de horas" (timesheets nativo) y "Tiempo y
         material" (industry_fsm_sale). La llegada y la finalización del servicio se
         muestran en su lugar dentro del cuerpo (sección "Horario del servicio"). -->
    <template id="visar_worksheet_report_hide_internal"
              inherit_id="industry_fsm.worksheet_custom_page" priority="98">
        <xpath expr="//div[@name='worksheet_task_timesheet']" position="replace"/>
    </template>
    <template id="visar_worksheet_report_hide_billing"
              inherit_id="industry_fsm_sale.worksheet_custom_page" priority="98">
        <xpath expr="//t[@t-call='industry_fsm_sale.worksheet_time_and_material']/.."
               position="replace"/>
    </template>

    <!-- (8) Etiqueta del bloque de firma nativo: "Firma" → "Firma y nombre del
         cliente" (el nombre de quien firma ya se pinta debajo del trazo). -->
    <template id="visar_worksheet_report_signature_label"
              inherit_id="industry_fsm.worksheet_custom_page" priority="98">
        <xpath expr="//div[@name='worksheet_signature']//h5" position="replace">
            <h5>Firma y nombre del cliente</h5>
        </xpath>
    </template>

    <!-- La cabecera de marca (logo + datos de Visar) se repite en TODAS las páginas
         (comportamiento nativo de wkhtmltopdf: el <div class="header"> del
         external_layout_bold se imprime en cada hoja). Antes se ocultaba a partir de la
         página 2; el cliente pidió que salga siempre. -->

    <!-- Cuerpo del reporte: reemplaza el render AUTOGENERADO de la worksheet por la
         maqueta Visar (secciones etiqueta/valor, subfichas como tabla, galerías de
         fotos). Para Fumigación las secciones vienen ya ordenadas para el cliente
         (Servicios → Horario → Áreas → Evidencia); para el resto de plantillas son
         las pestañas del notebook. Si la tarea no produjo secciones legibles se
         conserva el render nativo como respaldo. -->
    <template id="visar_worksheet_report_page"
              inherit_id="industry_fsm.worksheet_custom_page" priority="99">
        <xpath expr="//t[div[@name='worksheet_map']]" position="replace">
            <t t-if="visar_worksheet_map and visar_worksheet_map.get(doc.id)">
                <!-- Acento = color de marca de la empresa (mismo que la cabecera del
                     external_layout), para que TODO el documento sea coherente. Se
                     interpola aquí porque el WebKit de wkhtmltopdf no soporta var(). -->
                <t t-set="visar_accent" t-value="doc.company_id.primary_color or '#5faf33'"/>
                <div class="o_visar_ws">
                    <style>
                        .o_visar_ws { margin-top: 12px; font-size: 14px; color: #202020; }
                        .o_visar_ws_section { margin-bottom: 14px; }
                        .o_visar_ws_title {
                            font-size: 15px; font-weight: 700; text-transform: uppercase;
                            letter-spacing: .03em; color: <t t-esc="visar_accent"/>;
                            margin: 14px 0 6px 0; padding-bottom: 3px;
                            border-bottom: 2px solid <t t-esc="visar_accent"/>;
                        }
                        .o_visar_ws_row {
                            display: flex; align-items: baseline; gap: 10px;
                            padding: 4px 0; border-bottom: 1px solid #eef1f5;
                            page-break-inside: avoid;
                        }
                        .o_visar_ws_label {
                            flex: 0 0 34%; font-weight: 600; color: #555;
                        }
                        .o_visar_ws_value { flex: 1 1 auto; word-break: break-word; }
                        .o_visar_ws_value p { margin: 0 0 4px 0; }
                        .o_visar_ws_badge {
                            display: inline-block; padding: 1px 9px; border-radius: 10px;
                            font-size: 13px; font-weight: 700;
                        }
                        .o_visar_ws_badge.is-yes {
                            background: <t t-esc="visar_accent"/>; color: #fff;
                        }
                        .o_visar_ws_badge.is-no  { background: #f2f3f5; color: #6b7280; }
                        .o_visar_ws_img {
                            max-height: 190px; max-width: 100%;
                            border: 1px solid #e0e0e0; border-radius: 4px;
                        }
                        .o_visar_ws_block { padding: 6px 0; }
                        .o_visar_ws_block > .o_visar_ws_label {
                            display: block; margin-bottom: 5px;
                        }
                        table.o_visar_ws_table {
                            width: 100%; border-collapse: collapse; font-size: 13px;
                        }
                        table.o_visar_ws_table th {
                            background: <t t-esc="visar_accent"/>; color: #fff;
                            text-align: left; padding: 5px 7px; font-weight: 600;
                        }
                        table.o_visar_ws_table td {
                            padding: 4px 7px; border-bottom: 1px solid #e6e9ef;
                            vertical-align: top;
                        }
                        table.o_visar_ws_table tr:nth-child(even) td { background: #f4f8ee; }
                        table.o_visar_ws_table tr { page-break-inside: avoid; }
                        .o_visar_ws_thumb {
                            max-height: 54px; max-width: 90px;
                            border: 1px solid #e0e0e0; border-radius: 3px;
                        }
                        .o_visar_ws_gallery {
                            display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px;
                        }
                        .o_visar_ws_gimg {
                            max-height: 175px; max-width: 48%;
                            border: 1px solid #e0e0e0; border-radius: 4px;
                            page-break-inside: avoid;
                        }
                        /* Aviso destacado (áreas que el cliente no autorizó). El
                           cliente FIRMA este documento, así que tiene que verse.
                           Se apoya en borde grueso + negritas, no solo en color:
                           el reporte se imprime en blanco y negro a menudo. */
                        .o_visar_ws_notice {
                            border: 1px solid #e6a23c;
                            border-left: 5px solid #e6a23c;
                            background: #fdf6ec;
                            padding: 9px 12px;
                            margin: 6px 0;
                            page-break-inside: avoid;
                        }
                        .o_visar_ws_notice_title {
                            font-weight: 700; color: #8a5200;
                            text-transform: none; margin-bottom: 5px;
                        }
                        /* Lista de áreas: `inline-block` en vez de flex — el WebKit
                           viejo de wkhtmltopdf rompe el wrap de flex con gap. */
                        .o_visar_ws_notice_items { margin: 0 0 6px 0; }
                        .o_visar_ws_notice_item {
                            display: inline-block; background: #fff;
                            border: 1px solid #e6a23c; border-radius: 3px;
                            padding: 1px 8px; margin: 0 5px 4px 0;
                            font-weight: 700; font-size: 13px;
                        }
                        .o_visar_ws_notice_text { font-size: 12.5px; color: #4b4b4b; }
                    </style>
                    <t t-foreach="visar_worksheet_map.get(doc.id)" t-as="section"
                       t-key="section_index">
                        <div class="o_visar_ws_section">
                            <div t-if="section['title']" class="o_visar_ws_title"
                                 t-out="section['title']"/>
                            <t t-foreach="section['fields']" t-as="f" t-key="f_index">
                                <!-- Subficha one2many como tabla -->
                                <div t-if="f['kind'] == 'table'" class="o_visar_ws_block">
                                    <span t-if="f['label']" class="o_visar_ws_label"
                                          t-out="f['label']"/>
                                    <table class="o_visar_ws_table">
                                        <thead>
                                            <tr>
                                                <th t-foreach="f['columns']" t-as="col"
                                                    t-key="col_index" t-out="col"/>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="f['rows']" t-as="row"
                                                t-key="row_index">
                                                <td t-foreach="row" t-as="cell"
                                                    t-key="cell_index">
                                                    <img t-if="cell['kind'] == 'image' and cell['image']"
                                                         class="o_visar_ws_thumb"
                                                         t-att-src="image_data_uri(cell['image'])"/>
                                                    <span t-elif="cell['kind'] == 'bool'"
                                                          t-out="'Sí' if cell['bool'] else 'No'"/>
                                                    <span t-elif="cell['kind'] == 'scalar'"
                                                          t-out="cell['text']"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <!-- Aviso destacado: hoy, las áreas que el cliente
                                     no autorizó tratar. Va en caja para que no se
                                     pase por alto al revisar antes de firmar. -->
                                <div t-elif="f['kind'] == 'notice'" class="o_visar_ws_notice">
                                    <div t-if="f['label']" class="o_visar_ws_notice_title"
                                         t-out="f['label']"/>
                                    <div t-if="f.get('items')" class="o_visar_ws_notice_items">
                                        <span t-foreach="f['items']" t-as="item"
                                              t-key="item_index"
                                              class="o_visar_ws_notice_item" t-out="item"/>
                                    </div>
                                    <div t-if="f.get('text')" class="o_visar_ws_notice_text"
                                         t-out="f['text']"/>
                                </div>
                                <!-- Galería de fotos (evidencia) -->
                                <div t-elif="f['kind'] == 'gallery'" class="o_visar_ws_block">
                                    <span class="o_visar_ws_label" t-out="f['label']"/>
                                    <div class="o_visar_ws_gallery">
                                        <img t-foreach="f['images']" t-as="img"
                                             t-key="img_index" class="o_visar_ws_gimg"
                                             t-att-src="image_data_uri(img)"/>
                                    </div>
                                </div>
                                <!-- Foto (campo binario principal) -->
                                <div t-elif="f['kind'] == 'image'" class="o_visar_ws_block">
                                    <span class="o_visar_ws_label" t-out="f['label']"/>
                                    <div><img class="o_visar_ws_img"
                                              t-att-src="image_data_uri(f['image'])"/></div>
                                </div>
                                <!-- Texto enriquecido (html) -->
                                <div t-elif="f['kind'] == 'html'" class="o_visar_ws_row">
                                    <span class="o_visar_ws_label" t-out="f['label']"/>
                                    <div class="o_visar_ws_value" t-out="f['html']"/>
                                </div>
                                <!-- Booleano -->
                                <div t-elif="f['kind'] == 'bool'" class="o_visar_ws_row">
                                    <span class="o_visar_ws_label" t-out="f['label']"/>
                                    <div class="o_visar_ws_value">
                                        <span t-attf-class="o_visar_ws_badge #{'is-yes' if f['bool'] else 'is-no'}"
                                              t-out="'Sí' if f['bool'] else 'No'"/>
                                    </div>
                                </div>
                                <!-- Escalar / relacional simple -->
                                <div t-else="" class="o_visar_ws_row">
                                    <span class="o_visar_ws_label" t-out="f['label']"/>
                                    <div class="o_visar_ws_value" t-out="f['text']"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
            <!-- Respaldo: render nativo autogenerado si no hay lectura Visar. -->
            <t t-elif="doc.worksheet_count and doc.worksheet_template_id.report_view_id and worksheet_map.get(doc.id)">
                <div name="worksheet_map" style="page-break-inside: avoid">
                    <br/>
                    <h2>Worksheet</h2>
                    <t t-set="worksheet" t-value="worksheet_map.get(doc.id)"/>
                    <t t-call="#{doc.worksheet_template_id.report_view_id.id}"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
