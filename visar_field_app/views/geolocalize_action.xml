<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción de gestión: geolocaliza los clientes de servicios abiertos que aún
         no tienen coordenadas, para que aparezcan en el mapa de la app de campo.
         La ejecuta gestión (hr.group_hr_user), no los técnicos. -->
    <record id="visar_field_geolocalize_action" model="ir.actions.server">
        <field name="name">Geolocalizar direcciones de clientes</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">action = model._visar_geolocalize_service_partners()</field>
    </record>

    <menuitem id="visar_field_menu_geolocalize" name="Geolocalizar direcciones de clientes"
              parent="visar_field_menu_root"
              action="visar_field_geolocalize_action" sequence="30"
              groups="hr.group_hr_user"/>

    <!-- Cron: geolocaliza en segundo plano las direcciones de servicio que aún no
         tienen coordenadas (mismo método que la acción manual, force=False → solo
         las faltantes). Así los servicios nuevos aparecen en el mapa de la app sin
         que gestión ni el técnico tengan que dispararlo a mano.
         En un bloque noupdate para que ajustes del admin (frecuencia, activar/
         desactivar) no se pisen al actualizar el módulo. -->
    <data noupdate="1">
        <record id="visar_field_geolocalize_cron" model="ir.cron">
            <field name="name">Visar App de Campo: geolocalizar direcciones de servicio</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">model._visar_geolocalize_service_partners()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>

</odoo>
