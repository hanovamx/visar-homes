<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_view_form_visar_field" model="ir.ui.view">
        <field name="name">project.task.form.visar.field</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">210</field>
        <field name="arch" type="xml">

            <!-- Botón inteligente: previsualiza el MISMO reporte PDF que ve el técnico
                 al cerrar el servicio en la app de campo. Los botones nativos vecinos
                 ("Hoja de trabajo Completada" abre el formulario; "Previsualización del
                 cliente" abre el portal HTML) no muestran ese PDF renderizado. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="visar_action_view_worksheet_report"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-pdf-o"
                        groups="project.group_project_user"
                        invisible="not is_fsm or has_template_ancestor or has_project_template">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Reporte</span>
                        <span class="o_stat_text">(PDF)</span>
                    </div>
                </button>
                <!-- Adicionales vendidos en sitio. El pedido vive APARTE del que
                     originó el servicio (ver la nota en `_visar_upsell_order`), así
                     que este botón es la vía por la que administración lo encuentra:
                     sin él, la venta solo asomaba en un campo dentro de una pestaña.
                     Muestra el monto porque es el dato por el que se pregunta. -->
                <button name="action_visar_view_upsell_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        groups="project.group_project_user"
                        invisible="not visar_upsell_order_id">
                    <!-- Monto con `widget="monetary"` y NO con `statinfo`: el widget
                         statinfo llama al formateador sin los datos del registro, así
                         que un campo monetario le sale sin símbolo de moneda. Con la
                         maqueta explícita (misma que el botón del reporte) el importe
                         se pinta completo. -->
                    <!-- `currency_id` y `visar_upsell_order_id` NO se declaran aquí:
                         ya viven en el arch combinado (el botón "Products" nativo de
                         industry_fsm_sale trae la moneda; el pedido, la pestaña
                         "Visar - Campo" de abajo). Declararlos otra vez duplicaría
                         campos en la misma vista. -->
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="visar_upsell_amount_total" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Adicionales</span>
                    </div>
                </button>
            </xpath>

            <!-- Atribución del cierre en campo (quién cerró el servicio).
                 La asignación de técnicos vive en visar_fsm; la worksheet y la firma
                 son nativas (industry_fsm) y se ven en sus propias secciones. -->
            <xpath expr="//notebook" position="inside">
                <page name="visar_field" string="Visar - Campo">
                    <group>
                        <group string="Flujo en sitio">
                            <field name="visar_enroute_at" readonly="1"/>
                            <field name="visar_enroute_eta_minutes" readonly="1"/>
                            <field name="visar_arrived_at" readonly="1"/>
                            <field name="visar_travel_minutes" readonly="1"/>
                            <field name="visar_waiting_start" readonly="1"/>
                            <field name="visar_service_start" readonly="1"/>
                            <field name="visar_client_wait_minutes" readonly="1"/>
                            <field name="visar_worksheet_last_saved_at" readonly="1"/>
                            <field name="visar_onsite_minutes" readonly="1"/>
                        </group>
                        <group string="Cierre en campo">
                            <!-- Borrador sin guardado completo = hoja a medias: el
                                 técnico capturó algo pero no cerró la hoja. Se muestra
                                 solo en ese caso, que es cuando informa. -->
                            <field name="visar_worksheet_draft_at" readonly="1"
                                   invisible="not visar_worksheet_draft_at or visar_worksheet_saved_at"/>
                            <field name="visar_worksheet_saved_at" readonly="1"/>
                            <field name="visar_worksheet_saved_by_id" readonly="1"/>
                            <field name="visar_field_closed_by_id" readonly="1"/>
                            <field name="visar_field_closed_at" readonly="1"/>
                        </group>
                        <group string="Venta en campo (upsell)">
                            <field name="visar_upsell_order_id" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
