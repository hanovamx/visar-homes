<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_view_form_visar_field" model="ir.ui.view">
        <field name="name">project.task.form.visar.field</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">210</field>
        <field name="arch" type="xml">

            <!-- Botón inteligente: previsualiza el MISMO reporte PDF que ve el técnico
                 al cerrar el servicio en la app de campo. Los botones nativos vecinos
                 ("Hoja de trabajo Completada" abre el formulario; "Previsualización del
                 cliente" abre el portal HTML) no muestran ese PDF renderizado. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="visar_action_view_worksheet_report"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-pdf-o"
                        groups="project.group_project_user"
                        invisible="not is_fsm or has_template_ancestor or has_project_template">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Reporte</span>
                        <span class="o_stat_text">(PDF)</span>
                    </div>
                </button>
                <!-- Adicionales vendidos en sitio. Desde el 17-sep-2026 las líneas
                     entran al pedido del propio servicio (ver la nota en
                     `_visar_upsell_destino`), así que este botón lleva al documento
                     donde quedaron y el monto de al lado es lo vendido EN ESTA
                     VISITA, no el total del pedido. -->
                <button name="action_visar_view_upsell_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        groups="project.group_project_user"
                        invisible="not visar_upsell_order_id">
                    <!-- Monto con `widget="monetary"` y NO con `statinfo`: el widget
                         statinfo llama al formateador sin los datos del registro, así
                         que un campo monetario le sale sin símbolo de moneda. Con la
                         maqueta explícita (misma que el botón del reporte) el importe
                         se pinta completo. -->
                    <!-- `currency_id` y `visar_upsell_order_id` NO se declaran aquí:
                         ya viven en el arch combinado (el botón "Products" nativo de
                         industry_fsm_sale trae la moneda; el pedido, la pestaña
                         "Visar - Campo" de abajo). Declararlos otra vez duplicaría
                         campos en la misma vista. -->
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="visar_upsell_amount_total" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Adicionales</span>
                    </div>
                </button>
            </xpath>

            <!-- "Solicitar reagenda al cliente": el equivalente de backend del
                 botón "Cliente no llegó" de la app de campo, para cuando el
                 coordinador tiene que arrancarlo él (el cliente llamó, o el
                 técnico no pudo usar la app).

                 Va en la CABECERA y llama a un método: el envío tiene que colgar
                 de una acción explícita. Si colgara del valor de la etapa,
                 arrastrar la tarjeta a "Incidencia — Reprogramar" en el Kanban le
                 mandaría un WhatsApp a un cliente que no lo pidió. De ahí también
                 el `confirm`: no es un botón que convenga pulsar sin querer. -->
            <xpath expr="//header" position="inside">
                <button name="visar_action_request_reschedule"
                        type="object"
                        string="Solicitar reagenda al cliente"
                        groups="project.group_project_user"
                        confirm="Se le enviará un WhatsApp al cliente invitándole a elegir un horario nuevo, y el servicio quedará en «Incidencia — Reprogramar». ¿Continuar?"
                        invisible="not is_fsm or state in ['1_done'] or has_template_ancestor or has_project_template"/>
            </xpath>

            <!-- Atribución del cierre en campo (quién cerró el servicio).
                 La asignación de técnicos vive en visar_fsm; la worksheet y la firma
                 son nativas (industry_fsm) y se ven en sus propias secciones. -->
            <xpath expr="//notebook" position="inside">
                <page name="visar_field" string="Visar - Campo">
                    <group>
                        <group string="Flujo en sitio">
                            <field name="visar_enroute_at" readonly="1"/>
                            <field name="visar_enroute_eta_minutes" readonly="1"/>
                            <field name="visar_arrived_at" readonly="1"/>
                            <field name="visar_travel_minutes" readonly="1"/>
                            <field name="visar_waiting_start" readonly="1"/>
                            <field name="visar_service_start" readonly="1"/>
                            <field name="visar_client_wait_minutes" readonly="1"/>
                            <field name="visar_worksheet_last_saved_at" readonly="1"/>
                            <field name="visar_onsite_minutes" readonly="1"/>
                        </group>
                        <group string="Cierre en campo">
                            <!-- Borrador sin guardado completo = hoja a medias: el
                                 técnico capturó algo pero no cerró la hoja. Se muestra
                                 solo en ese caso, que es cuando informa. -->
                            <field name="visar_worksheet_draft_at" readonly="1"
                                   invisible="not visar_worksheet_draft_at or visar_worksheet_saved_at"/>
                            <field name="visar_worksheet_saved_at" readonly="1"/>
                            <field name="visar_worksheet_saved_by_id" readonly="1"/>
                            <field name="visar_field_closed_by_id" readonly="1"/>
                            <field name="visar_field_closed_at" readonly="1"/>
                        </group>
                        <!-- Hasta ahora la solicitud de reagenda solo existía en
                             el chatter y en la actividad: quien abría la tarea no
                             tenía forma de ver que ya se le había pedido al cliente
                             elegir horario. -->
                        <group string="Reagenda solicitada"
                               invisible="not visar_reschedule_requested_at">
                            <field name="visar_reschedule_requested_at" readonly="1"/>
                            <field name="visar_reschedule_requested_by_id" readonly="1"/>
                        </group>
                        <group string="Venta en campo (upsell)">
                            <field name="visar_upsell_order_id" readonly="1"/>
                            <field name="visar_upsell_amount_total" readonly="1"
                                   invisible="not visar_upsell_order_id"/>
                            <field name="visar_upsell_cash_at" readonly="1"
                                   invisible="not visar_upsell_cash_at"/>
                            <field name="visar_upsell_cash_by_id" readonly="1"
                                   invisible="not visar_upsell_cash_at"/>
                        </group>
                    </group>
                    <!-- Inventario por ruta (23-sep-2026): qué se gastó, de dónde
                         salió y cuánto se recorrió para llegar. -->
                    <group string="Consumo de inventario"
                           invisible="not visar_consumo_ids and not visar_consumo_at">
                        <field name="visar_consumo_at" readonly="1"/>
                        <field name="visar_consumo_ids" readonly="1" nolabel="1" colspan="2">
                            <list>
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="uom_name"/>
                                <field name="employee_id"/>
                            </list>
                        </field>
                        <field name="visar_consumo_move_ids" readonly="1" nolabel="1"
                               colspan="2" invisible="not visar_consumo_move_ids">
                            <list string="Movimientos generados">
                                <field name="product_id"/>
                                <field name="product_uom_qty"/>
                                <field name="location_id"/>
                                <field name="location_dest_id"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                    <group string="Recorrido" invisible="not visar_odometer_arrival">
                        <field name="visar_odometer_session_id" readonly="1"/>
                        <field name="visar_odometer_arrival" readonly="1"/>
                        <field name="visar_km_leg" readonly="1"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
