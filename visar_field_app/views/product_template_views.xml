<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Marca de "vendible en campo": va junto a la casilla de Ventas porque es la
         misma decisión comercial, un canal más. Sin esto el catálogo de la app se
         administra solo por código.

         En su PROPIO `span`, y ahí está la corrección del 17-sep-2026: el campo se
         insertaba detrás de `sale_ok`, que vive en un span junto a SU etiqueta
         (`<label for="sale_ok"/>`). Al colarse en medio, la fila se veía con cuatro
         casillas y tres textos: la palabra "Ventas" quedaba pegada a esta casilla y
         la de Ventas sin texto. Lo reportó Visar abriendo "Estación antirroedores". -->
    <record id="product_template_form_visar_upsell" model="ir.ui.view">
        <field name="name">product.template.form.visar.upsell</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']/span[@name='sale_option']" position="after">
                <span class="d-inline-flex" name="visar_upsell_option"
                      invisible="not sale_ok">
                    <field name="visar_upsell_ok"/>
                    <label for="visar_upsell_ok"/>
                </span>
            </xpath>
        </field>
    </record>

    <!-- Insumo aplicable en campo (23-sep-2026). Fuera del `invisible="not sale_ok"`
         del bloque de arriba a propósito: un plaguicida se CONSUME, no se vende, y
         casi ninguno lleva la casilla de Ventas encendida. -->
    <record id="product_template_form_visar_consumible" model="ir.ui.view">
        <field name="name">product.template.form.visar.consumible</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']/span[@name='sale_option']" position="after">
                <span class="d-inline-flex" name="visar_consumible_option">
                    <field name="visar_consumible_ok"/>
                    <label for="visar_consumible_ok"/>
                </span>
            </xpath>
        </field>
    </record>

    <!-- Tratamientos que se cotizan a mano (22-sep-2026): qué servicio de la hoja de
         trabajo pide su cotización. En la pestaña de Ventas, con el resto de lo que
         decide cómo se vende el producto. -->
    <record id="product_template_form_visar_quote" model="ir.ui.view">
        <field name="name">product.template.form.visar.quote</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']//group[@name='sale']" position="inside">
                <field name="visar_quote_trigger" placeholder="p. ej. Termitas"/>
            </xpath>
        </field>
    </record>

    <!-- Filtro para revisar de un vistazo qué se está ofreciendo en campo. -->
    <record id="product_template_search_visar_upsell" model="ir.ui.view">
        <field name="name">product.template.search.visar.upsell</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="after">
                <filter name="visar_upsell_ok" string="Vendible en campo (upsell)"
                        domain="[('visar_upsell_ok', '=', True)]"/>
                <filter name="visar_consumible_ok" string="Insumo aplicable en campo"
                        domain="[('visar_consumible_ok', '=', True)]"/>
            </filter>
        </field>
    </record>

</odoo>
