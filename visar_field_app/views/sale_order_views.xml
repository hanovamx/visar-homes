<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Trazabilidad del upsell en el pedido de venta.

         Desde el 17-sep-2026 el adicional entra como LÍNEA de este mismo pedido
         (el porqué, en `project.task._visar_upsell_destino`). Las columnas opcionales
         de la lista de líneas son lo que distingue "esto lo vendió el técnico en la
         puerta" de lo que el cliente ya había comprado.

         Los campos de cabecera y el botón de abajo siguen sirviendo a los dos casos
         que conservan pedido aparte —pólizas y pedidos que no se pueden tocar— y a
         los 10 adicionales vendidos antes de esa fecha.
         ================================================================ -->
    <record id="view_order_form_visar_upsell" model="ir.ui.view">
        <field name="name">sale.order.form.visar.upsell</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Vendedor como empleado, debajo del Vendedor estándar en "Otra
                 información". Los dos quedan visibles y sin relación entre ellos. -->
            <xpath expr="//group[@name='sales_person']/field[@name='user_id']" position="after">
                <field name="visar_salesperson_employee_id"
                       options="{'no_create': True}"/>
            </xpath>

            <!-- (a) Desde el pedido ORIGINAL: todo lo que sus visitas vendieron en
                 campo. Una póliza acumula uno por visita, de ahí el contador. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_visar_view_upsell_orders" type="object"
                        class="oe_stat_button" icon="fa-shopping-cart"
                        invisible="visar_upsell_order_count == 0">
                    <field name="visar_upsell_order_count" widget="statinfo"
                           string="Adicionales"/>
                </button>
            </xpath>

            <!-- (b) En el pedido DE ADICIONALES: de qué servicio salió, de qué venta
                 venía ese servicio, quién lo vendió y cómo se cobró. Los cuatro
                 campos existían desde el primer día pero no estaban en ninguna vista:
                 la trazabilidad estaba en la base de datos y en ningún lado más. -->
            <xpath expr="//notebook" position="inside">
                <page name="visar_upsell" string="Visar - Venta en campo"
                      invisible="not visar_upsell_task_id">
                    <group>
                        <group string="Origen">
                            <field name="visar_upsell_task_id"
                                   options="{'no_create': True}" readonly="1"/>
                            <field name="visar_upsell_source_order_id"
                                   options="{'no_create': True}" readonly="1"/>
                        </group>
                        <group string="Cobro en sitio">
                            <!-- Base de la comisión del 10% al técnico. -->
                            <field name="visar_upsell_employee_id"
                                   options="{'no_create': True}" readonly="1"/>
                            <field name="visar_upsell_cash_at" readonly="1"/>
                            <field name="visar_upsell_cash_by_id"
                                   options="{'no_create': True}" readonly="1"
                                   invisible="not visar_upsell_cash_at"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Filtro y agrupaciones. `visar_upsell_task_id` puesto es la definición de
         "pedido nacido en campo": no hace falta un booleano aparte. Agrupar por
         técnico es el reporte que pide el requerimiento de comisiones (10% de todo
         lo que venda como upsell). -->
    <record id="view_sales_order_filter_visar_upsell" model="ir.ui.view">
        <field name="name">sale.order.search.visar.upsell</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <separator/>
                <filter name="visar_upsell" string="Venta en campo (adicionales)"
                        domain="['|', ('visar_upsell_task_id', '!=', False),
                                 ('order_line.visar_upsell_task_id', '!=', False)]"/>
                <filter name="visar_upsell_cash" string="Cobrado en efectivo en sitio"
                        domain="[('visar_upsell_cash_at', '!=', False)]"/>
            </filter>
            <filter name="salesperson" position="after">
                <filter name="visar_salesperson_employee" string="Vendedor (empleado)"
                        context="{'group_by': 'visar_salesperson_employee_id'}"/>
                <filter name="visar_upsell_technician" string="Técnico (upsell)"
                        context="{'group_by': 'visar_upsell_employee_id'}"/>
                <filter name="visar_upsell_task" string="Servicio de origen"
                        context="{'group_by': 'visar_upsell_task_id'}"/>
            </filter>
        </field>
    </record>

    <!-- Columnas opcionales en la lista: ocultas por defecto (`optional="hide"`), se
         encienden desde el selector de columnas. Así el filtro de arriba sirve para
         algo sin cambiarle la lista de pedidos a quien no trabaja el upsell. -->
    <record id="view_order_tree_visar_upsell" model="ir.ui.view">
        <field name="name">sale.order.list.visar.upsell</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="visar_salesperson_employee_id" optional="hide"/>
                <field name="visar_upsell_employee_id" optional="hide"/>
                <field name="visar_upsell_task_id" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Lista de LÍNEAS de pedido (Ventas ▸ Informes y el selector de columnas):
         quién vendió cada línea en campo y cuándo. Es lo único que separa el
         adicional del servicio contratado ahora que comparten documento, y es el eje
         por el que se calculará la comisión del técnico. Ocultas por defecto
         (`optional="hide"`): quien no trabaja upsell no ve columnas nuevas. -->
    <record id="view_order_line_tree_visar_upsell" model="ir.ui.view">
        <field name="name">sale.order.line.list.visar.upsell</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <field name="salesman_id" position="after">
                <field name="visar_upsell_employee_id" optional="hide"/>
                <field name="visar_upsell_task_id" optional="hide"/>
                <field name="visar_upsell_at" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
