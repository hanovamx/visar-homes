<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: el staff puede ajustar frecuencia/activo sin que un upgrade lo
         pise (mismo patrón que el cron de visar_crm). -->
    <data noupdate="1">
        <record id="visar_wa_outbox_cron" model="ir.cron">
            <field name="name">Visar App de Campo: enviar avisos de WhatsApp pendientes</field>
            <field name="model_id" ref="model_visar_wa_message"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_send_pending()</field>
            <field name="user_id" ref="base.user_root"/>
            <!-- El intervalo es la RED DE SEGURIDAD para reintentos, no el camino
                 normal: al encolar un aviso se dispara el cron (`_trigger()`), así
                 que en el camino feliz sale en segundos sin que el técnico espere. -->
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
