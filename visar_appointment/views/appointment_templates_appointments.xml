<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Elegir fecha y hora": su propio texto, no el de introducción (25-sep-2026).

         Odoo nativo pinta `message_intro` aquí bajo el encabezado "Descripción",
         además de en la página de introducción. Al cliente le llega el mismo
         mensaje dos veces, en dos pasos distintos, y deja de servir para lo que
         estaba: ayudarle a ELEGIR el servicio en el primer paso.

         Vacío = no se pinta el bloque (ni encabezado ni caja). No hay respaldo al
         de introducción a propósito: sería volver a la duplicación de antes. -->
    <template id="visar_appointment_datetime_message" inherit_id="appointment.appointment_info">
        <xpath expr="//div[div[@t-field='appointment_type.message_intro']]" position="replace">
            <div t-attf-class="o_appointment_intro border-top pt-4 mt-4 #{'d-none' if not appointment_type.active or is_html_empty(appointment_type.visar_message_datetime) else ''}">
                <div t-field="appointment_type.visar_message_datetime"
                     placeholder="Escribe aquí el texto de la pantalla de fecha y hora…"/>
            </div>
        </xpath>
    </template>

    <template id="visar_appointment_info_price" inherit_id="website_appointment_sale.appointment_info">
        <xpath expr="//span[hasclass('o_appointment_details_price')]" position="replace">
            <t t-set="quote" t-value="visar_quote or False"/>
            <t t-set="quote_currency" t-value="quote and request.env['res.currency'].browse(quote['currency_id']) or False"/>
            <span t-if="quote" class="o_appointment_details_price o_visar_quote_price flex-grow-1">
                <t t-foreach="quote['lines']" t-as="line">
                    <div class="d-flex justify-content-between gap-2 small mb-1"
                         t-att-class="'text-muted' if line.get('is_free') else ('ps-2' if line.get('is_addon') else None)">
                        <span t-esc="line['name']"/>
                        <span>
                            <span t-if="line.get('has_discounted_price') and line.get('list_price')"
                                  class="oe_striked_price me-1"
                                  t-out="line['list_price']"
                                  t-options="{'widget': 'monetary', 'display_currency': quote_currency}"/>
                            <span t-out="line['price']"
                                  t-options="{'widget': 'monetary', 'display_currency': quote_currency}"/>
                        </span>
                    </div>
                </t>
                <!-- Con póliza, lo que se cobra HOY no es el importe de un periodo:
                     la mensual cobra 3 meses de entrada. Enseñar el "al mes" como si
                     fuera el cargo sería mentir sobre la liga de pago. Mismo criterio
                     que `_visar_wizard_summary`. -->
                <t t-if="quote['plan']">
                    <div class="d-flex justify-content-between pt-1 border-top">
                        <strong>Hoy pagas</strong>
                        <strong t-out="quote['upfront_total']"
                                t-options="{'widget': 'monetary', 'display_currency': quote_currency}"/>
                    </div>
                    <div class="small text-muted">
                        Luego <t t-out="quote['recurring_total']"
                                 t-options="{'widget': 'monetary', 'display_currency': quote_currency}"/>
                        <t t-esc="quote['period_label']"/>
                    </div>
                </t>
                <div t-else="" class="d-flex justify-content-between pt-1 border-top">
                    <strong>Total</strong>
                    <strong t-out="quote['total']"
                            t-options="{'widget': 'monetary', 'display_currency': quote_currency}"/>
                </div>
            </span>
            <t t-else="">
                <t t-set="combination_info" t-value="appointment_type.product_id.product_tmpl_id._get_combination_info(
                    product_id=appointment_type.product_id.id,
                    add_qty=asked_capacity if isDetailsManageCapacity else 1.0)"/>
                <span class="o_appointment_details_price">
                    <strong t-out="combination_info['price'] * asked_capacity if isDetailsManageCapacity else combination_info['price']"
                        t-options="{'widget': 'monetary', 'display_currency': combination_info['currency']}"/>
                    <span t-if="not isDetails and combination_info['has_discounted_price']" class="oe_striked_price"
                        t-out="combination_info['list_price']"
                        t-options="{'widget': 'monetary', 'display_currency': combination_info['currency']}"/>
                </span>
            </t>
        </xpath>
    </template>

    <!-- ==================================================================
         "Presencial" en vez de "En línea"

         Todos los servicios de Visar son a domicilio: el técnico va a casa del
         cliente. Nunca hay videollamada.

         El texto no sale de ninguna configuración nuestra — los 4 tipos de cita
         tienen `location`, `location_id` y `event_videocall_source` vacíos. Es el
         valor por defecto del core: cuando no hay `location_id`, la plantilla cae
         a un ícono de cámara y la palabra "Online". Como el negocio nunca es en
         línea, ese default está mal en el 100% de los casos.

         Se corrige por herencia de plantilla y no llenando el campo `location` de
         cada tipo de cita, para que aplique también a los tipos que se creen
         después (criterio de aceptación del REQ-3923).
         ================================================================== -->

    <!-- Panel "Detalles de la reservación" del checkout: lo que ve el cliente
         antes de confirmar. -->
    <template id="visar_meeting_details_presencial"
              inherit_id="appointment.appointment_meeting_details">
        <xpath expr="//i[hasclass('fa-video-camera')]/.." position="replace">
            <div class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0" t-else="">
                <i class="fa fa-home fa-fw me-2 mt-1 text-muted"/>
                <span class="o_not_editable">Presencial</span>
            </div>
        </xpath>
    </template>

    <!-- Página de confirmación, fila "Dónde". Aquí el core ya respeta
         `event.location` si viene con texto; solo se corrige el último recurso. -->
    <template id="visar_appointment_validated_presencial"
              inherit_id="appointment.appointment_validated">
        <xpath expr="//t[@t-elif='based_on_users']" position="replace">
            <t t-elif="based_on_users"><span>Presencial</span></t>
        </xpath>
    </template>

    <!-- Tarjetas del listado de tipos de cita en el sitio. -->
    <template id="visar_appointment_card_presencial"
              inherit_id="website_appointment.appointment_card_body">
        <xpath expr="//i[hasclass('fa-video-camera')]/.." position="replace">
            <t t-else="">
                <i class="fa fa-home lh-base" role="presentation"/>
                <span class="o_not_editable">Presencial</span>
            </t>
        </xpath>
    </template>

</odoo>
