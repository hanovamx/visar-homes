<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="visar_dia_sin_servicio_list" model="ir.ui.view">
        <field name="name">visar.dia.sin.servicio.list</field>
        <field name="model">visar.dia.sin.servicio</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="fecha"/>
                <field name="dia_semana"/>
                <field name="motivo"/>
                <field name="todo_el_dia"/>
                <field name="hora_desde" widget="float_time" invisible="todo_el_dia"/>
                <field name="hora_hasta" widget="float_time" invisible="todo_el_dia"/>
                <field name="oficial"/>
                <field name="citas_count" decoration-warning="citas_count"/>
                <button name="action_ver_citas" type="object" string="Ver citas"
                        icon="fa-calendar" invisible="not citas_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="visar_dia_sin_servicio_search" model="ir.ui.view">
        <field name="name">visar.dia.sin.servicio.search</field>
        <field name="model">visar.dia.sin.servicio</field>
        <field name="arch" type="xml">
            <search>
                <field name="motivo"/>
                <filter name="proximos" string="Próximos"
                        domain="[('fecha', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="oficiales" string="Festivos oficiales" domain="[('oficial', '=', True)]"/>
                <filter name="propios" string="Agregados por Visar" domain="[('oficial', '=', False)]"/>
                <separator/>
                <filter name="archivados" string="Archivados (sí se trabaja)"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="visar_dia_sin_servicio_action" model="ir.actions.act_window">
        <field name="name">Días sin servicio</field>
        <field name="res_model">visar.dia.sin.servicio</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_proximos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Agregue un día en que no se trabaja</p>
            <p>Ese día (o el horario que indique) no se ofrece en la web, en
               WhatsApp, en el botón «Agendar» ni en la pre-agenda de
               suscripciones. Los festivos oficiales ya vienen cargados; si
               alguno sí se trabaja, archívelo. Las citas que ya existían ese día
               no se mueven solas: la columna «Citas ya agendadas» las muestra.</p>
        </field>
    </record>

    <menuitem id="visar_dia_sin_servicio_menu"
              name="Días sin servicio"
              parent="appointment.appointment_menu_config"
              action="visar_dia_sin_servicio_action"
              sequence="40"/>
</odoo>
