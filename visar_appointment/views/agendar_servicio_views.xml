<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- La guía: los horarios que el web y el agente le ofrecerían al cliente.
         Se elige uno y queda la cita de verdad, ocupando la agenda del técnico. -->
    <record id="visar_agendar_servicio_view_form" model="ir.ui.view">
        <field name="name">visar.agendar.servicio.form</field>
        <field name="model">visar.agendar.servicio</field>
        <field name="arch" type="xml">
            <form string="Agendar servicio">
                <field name="tareas_posibles_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="task_id" options="{'no_create': True, 'no_open': True}"
                               readonly="len(tareas_posibles_ids) &lt; 2"/>
                        <field name="zona_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="recurso_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="desde"/>
                        <field name="duracion" widget="float_time"/>
                        <button name="action_buscar" type="object" string="Buscar horarios"
                                class="btn-secondary" colspan="2"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="not nota">
                    <field name="nota" nolabel="1"/>
                </div>
                <p class="text-muted">
                    Solo aparecen horarios en que el técnico trabaja, está libre y le
                    da tiempo de llegar: lo mismo que ve el cliente en la web. Al elegir
                    uno se aparta en su agenda; al cliente no se le manda nada.
                </p>
                <field name="hueco_ids" readonly="1" nolabel="1">
                    <list create="0" delete="0" edit="0" no_open="1">
                        <field name="inicio" string="Día y hora"/>
                        <field name="recurso_id"/>
                        <field name="ruta" widget="badge"
                               decoration-success="ruta == 'cerca'"
                               decoration-muted="ruta == 'libre'"/>
                        <button name="action_elegir" type="object" string="Elegir"
                                class="btn-primary"/>
                    </list>
                </field>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="project_task_view_form_visar_agendar" model="ir.ui.view">
        <field name="name">project.task.form.visar.agendar</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">211</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="visar_agendable" invisible="1"/>
                <button name="action_visar_agendar" type="object" string="Agendar"
                        class="btn-primary" invisible="not visar_agendable"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_visar_agendar" model="ir.ui.view">
        <field name="name">sale.order.form.visar.agendar</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="visar_agendables_count" invisible="1"/>
                <button name="action_visar_agendar" type="object" string="Agendar servicio"
                        class="btn-primary" invisible="not visar_agendables_count"/>
            </xpath>
        </field>
    </record>

</odoo>
