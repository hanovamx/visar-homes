<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Festivos oficiales (LFT art. 74) del año en curso y el siguiente. Corre
         una vez al mes: el siguiente año queda sembrado con meses de margen. -->
    <data noupdate="1">
        <record id="visar_dia_sin_servicio_cron" model="ir.cron">
            <field name="name">Visar Citas: sembrar festivos oficiales</field>
            <field name="model_id" ref="model_visar_dia_sin_servicio"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_festivos()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    <!-- Al instalar/actualizar: que los festivos ya estén, sin esperar al cron.
         Idempotente (no duplica ni revive los archivados). -->
    <function model="visar.dia.sin.servicio" name="_visar_cron_festivos"/>
</odoo>
