<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_visar_sub" model="ir.ui.view">
        <field name="name">sale.order.form.visar.subscription</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_visar_view_visits" type="object"
                        class="oe_stat_button" icon="fa-wrench"
                        invisible="not is_subscription">
                    <field name="visar_visit_count" widget="statinfo" string="Visitas"/>
                </button>
                <button name="action_visar_add_warranty_visit" type="object"
                        class="oe_stat_button" icon="fa-shield"
                        invisible="not is_subscription"
                        string="Visita de garantía"/>
            </xpath>
            <!-- Fase 4: previsualizar descuento de combo antes de confirmar -->
            <xpath expr="//header" position="inside">
                <button name="action_visar_apply_combo_discount" type="object"
                        string="Aplicar descuento combo"
                        invisible="not visar_is_poliza or state not in ('draft', 'sent')"/>
            </xpath>
            <!-- Fase 3: bloquear cambio de dirección de servicio en pólizas confirmadas -->
            <field name="partner_shipping_id" position="attributes">
                <attribute name="readonly">visar_is_poliza and state == 'sale'</attribute>
            </field>
            <xpath expr="//field[@name='partner_shipping_id']" position="before">
                <field name="visar_is_poliza" invisible="1"/>
            </xpath>
            <!-- Fase 5: pestaña de siniestralidad (consumo de garantía) -->
            <xpath expr="//notebook" position="inside">
                <page string="Póliza — Siniestralidad" name="visar_siniestralidad"
                      invisible="not visar_is_poliza">
                    <group>
                        <group>
                            <field name="visar_service_visit_count"/>
                            <field name="visar_warranty_count"/>
                        </group>
                        <group>
                            <field name="visar_warranty_rate"/>
                            <field name="visar_last_warranty_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
