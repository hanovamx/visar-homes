<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_visar_sub" model="ir.ui.view">
        <field name="name">project.task.form.visar.subscription</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="visar_subscription_order_id"
                       invisible="not visar_subscription_order_id"
                       readonly="1"/>
                <field name="visar_source_invoice_id"
                       invisible="not visar_source_invoice_id"
                       readonly="1"/>
                <field name="visar_is_warranty"
                       invisible="not visar_subscription_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
