<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_plan_view_form_visar" model="ir.ui.view">
        <field name="name">sale.subscription.plan.form.visar</field>
        <field name="model">sale.subscription.plan</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='billing_period_unit']" position="after">
                <field name="visar_commitment_months"/>
                <field name="visar_first_invoice_periods"/>
                <!-- "Visitas incluidas" se quitó el 22-sep-2026: las visitas salen de los
                     meses pagados ÷ este número. -->
                <field name="visar_visit_interval_months"/>
            </xpath>
        </field>
    </record>
</odoo>
