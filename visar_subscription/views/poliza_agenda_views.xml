<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rezago de visitas de póliza: las que el cliente pagó y nadie ha agendado.
         Hasta ahora esto no existía en ninguna pantalla: solo la PRIMERA visita de una
         póliza nace con fecha (la que el cliente eligió al contratar) y las demás
         quedan sin fecha, visibles únicamente entrando pedido por pedido. El caso que
         lo motiva es real: un cliente con tres visitas sin rendir que nadie rastreaba
         tras la salida de un empleado. -->
    <record id="view_task_list_visar_poliza_agenda" model="ir.ui.view">
        <field name="name">project.task.list.visar.poliza.agenda</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list string="Visitas de póliza por agendar"
                  default_order="visar_visit_due_date asc, id asc"
                  create="false"
                  decoration-danger="visar_visit_days_late &gt; 0"
                  decoration-warning="visar_visit_days_late &lt;= 0 and visar_visit_days_late &gt; -8"
                  decoration-muted="visar_visit_due_out_of_term">
                <field name="visar_visit_due_date"/>
                <field name="visar_visit_days_late"/>
                <field name="partner_id"/>
                <field name="name" string="Visita"/>
                <field name="visar_subscription_order_id"/>
                <field name="visar_visit_seq" string="Nº"/>
                <field name="visar_visit_total" string="de"/>
                <field name="visar_poliza_end_date"/>
                <field name="visar_visit_due_out_of_term"/>
                <field name="visar_visit_due_manual" optional="hide"/>
                <field name="project_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_task_search_visar_poliza_agenda" model="ir.ui.view">
        <field name="name">project.task.search.visar.poliza.agenda</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search string="Visitas de póliza por agendar">
                <field name="partner_id"/>
                <field name="visar_subscription_order_id"/>
                <field name="name" string="Visita"/>
                <filter name="visar_vencidas" string="Vencidas"
                        domain="[('visar_visit_due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="visar_proximas" string="Próximos 30 días"
                        domain="[('visar_visit_due_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('visar_visit_due_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <!-- Sin ancla: la póliza no tiene NINGUNA visita con fecha real, así que
                     no hay desde dónde proponer. Se enseña como tal en vez de inventar
                     un origen; casi siempre significa que ni la primera se agendó. -->
                <filter name="visar_sin_ancla" string="Sin fecha propuesta"
                        domain="[('visar_visit_due_date', '=', False),
                                 ('visar_visit_due_out_of_term', '=', False)]"/>
                <filter name="visar_fuera_vigencia" string="Fuera de vigencia"
                        domain="[('visar_visit_due_out_of_term', '=', True)]"/>
                <group>
                    <filter name="visar_group_partner" string="Cliente"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="visar_group_poliza" string="Póliza"
                            context="{'group_by': 'visar_subscription_order_id'}"/>
                    <filter name="visar_group_mes" string="Mes propuesto"
                            context="{'group_by': 'visar_visit_due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_visar_poliza_agenda" model="ir.actions.act_window">
        <field name="name">Visitas de póliza por agendar</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_task_search_visar_poliza_agenda"/>
        <field name="domain">[('visar_subscription_order_id', '!=', False),
                              ('visar_visit_kind', '=', 'preventiva'),
                              ('planned_date_begin', '=', False),
                              ('state', 'not in', ['1_done', '1_canceled'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay visitas de póliza pendientes de agendar</p>
            <p>Aquí están las visitas que el cliente ya pagó y todavía no tienen fecha.</p>
        </field>
    </record>

    <record id="action_visar_poliza_agenda_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_task_list_visar_poliza_agenda"/>
        <field name="act_window_id" ref="action_visar_poliza_agenda"/>
    </record>

    <menuitem id="fsm_menu_planning_poliza_agenda_visar"
              name="Visitas de póliza por agendar"
              sequence="14"
              parent="industry_fsm.fsm_menu_planning"
              action="action_visar_poliza_agenda"
              groups="industry_fsm.group_fsm_manager"/>

</odoo>
