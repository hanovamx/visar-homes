<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="group_whatsapp_agent_readonly" model="res.groups">
        <field name="name">Agente WhatsApp / Solo lectura</field>
        <!-- Odoo 19: res.groups ya no tiene category_id (paso a privilege_id →
             res.groups.privilege). Un grupo tecnico para el usuario share no
             necesita privilege; se omite. -->
        <field name="comment">
            Permisos minimos para el usuario RPC del agente de WhatsApp
            (servicio visar_fastapi). Solo lectura sobre los modelos del
            catalogo y precios; sin acceso a ventas, citas ni datos de
            clientes. Principio de minimo privilegio.
        </field>
        <!-- El servicio corre en continuo: necesita una API key de larga
             duracion. Sin esto el cap del usuario share seria de 1 dia
             (max(api_key_duration) or 1.0). ~10 anios. -->
        <field name="api_key_duration">3650</field>
    </record>

    <record id="user_whatsapp_agent" model="res.users">
        <field name="name">Agente WhatsApp (RPC)</field>
        <field name="login">whatsapp_agent</field>
        <!-- Odoo 19: res.users.groups_id paso a group_ids. -->
        <field name="group_ids" eval="[(4, ref('group_whatsapp_agent_readonly'))]"/>
        <field name="share" eval="True"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
