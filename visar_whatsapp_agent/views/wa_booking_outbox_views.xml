<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="visar_wa_booking_message_view_list" model="ir.ui.view">
        <field name="name">visar.wa.booking.message.list</field>
        <field name="model">visar.wa.booking.message</field>
        <field name="arch" type="xml">
            <list string="Avisos de agendado" create="false">
                <field name="create_date"/>
                <field name="template_key"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="state" decoration-success="state == 'sent'"
                       decoration-danger="state in ('failed', 'expired')"
                       decoration-muted="state == 'cancelled'"/>
                <field name="attempts"/>
                <field name="sent_at"/>
                <field name="mode_used"/>
                <field name="last_error"/>
            </list>
        </field>
    </record>

    <record id="visar_wa_booking_message_view_form" model="ir.ui.view">
        <field name="name">visar.wa.booking.message.form</field>
        <field name="model">visar.wa.booking.message</field>
        <field name="arch" type="xml">
            <form string="Aviso de agendado" create="false">
                <header>
                    <button name="action_visar_retry" type="object" string="Reintentar"
                            class="btn-primary"
                            invisible="state not in ('failed', 'expired')"/>
                    <button name="action_visar_cancel" type="object" string="Cancelar"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="template_key"/>
                            <field name="phone"/>
                            <field name="partner_id"/>
                            <field name="calendar_booking_id"/>
                        </group>
                        <group>
                            <field name="expire_at"/>
                            <field name="sent_at"/>
                            <field name="attempts"/>
                            <field name="mode_used"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <group string="Texto">
                        <field name="fallback_text" nolabel="1"/>
                        <field name="params_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="visar_wa_booking_message_action" model="ir.actions.act_window">
        <field name="name">Avisos de agendado (WhatsApp)</field>
        <field name="res_model">visar.wa.booking.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin avisos todavía</p>
            <p>Aquí quedan las confirmaciones de pago y los avisos de apartado
               vencido que el agente manda por WhatsApp.</p>
        </field>
    </record>
    <menuitem id="menu_wa_booking_outbox"
              name="Avisos de agendado"
              parent="visar_whatsapp_agent.menu_agent_root"
              action="visar_wa_booking_message_action"
              sequence="20"/>

</odoo>
