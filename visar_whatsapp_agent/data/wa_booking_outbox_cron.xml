<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Red de seguridad para los reintentos. El envío normal no espera a
             este intervalo: encolar dispara el cron (`_trigger()`), igual que en
             la cola de correo nativa y en el buzón de la app de campo. -->
        <record id="visar_wa_booking_outbox_cron" model="ir.cron">
            <field name="name">Visar: avisos de agendado por WhatsApp</field>
            <field name="model_id" ref="model_visar_wa_booking_message"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_send_pending()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
