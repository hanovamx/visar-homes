<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: el staff puede ajustar frecuencia/activo sin que un upgrade lo
         pise (mismo patron que el resto de crons de Visar). -->
    <data noupdate="1">
        <!-- Decide A QUIEN se recontacta. No manda: encola en el buzon.
             Cada 15 min: la ventana habil dura horas, asi que la precision al
             minuto no compra nada y una corrida por minuto seria ruido en el log
             de un cron que casi siempre no tiene nada que hacer. -->
        <record id="visar_wa_lead_followup_cron" model="ir.cron">
            <field name="name">Visar: recontactar leads de WhatsApp</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._visar_wa_cron_followup()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Red de seguridad de los reintentos del buzon. El envio normal no
             espera a este intervalo: encolar dispara el cron (`_trigger()`). -->
        <record id="visar_wa_lead_outbox_cron" model="ir.cron">
            <field name="name">Visar: envio de recontactos por WhatsApp</field>
            <field name="model_id" ref="model_visar_wa_lead_message"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_send_pending()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
