<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Decide a qué visitas de suscripción les toca el aviso (14/7/2 días
             antes, en Ajustes → Visar) y lo encola. Cada hora: solo manda dentro
             de la ventana de horas configurada, y la idempotencia vive en la
             visita (el hito ya mandado), no en el intervalo. -->
        <record id="visar_poliza_aviso_cron" model="ir.cron">
            <field name="name">Visar: avisar por WhatsApp las visitas de suscripción</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_poliza_avisos()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <!-- El buzón: manda y reintenta. Encolar lo dispara al momento. -->
        <record id="visar_wa_poliza_outbox_cron" model="ir.cron">
            <field name="name">Visar: avisos de visitas de suscripción (buzón)</field>
            <field name="model_id" ref="model_visar_wa_poliza_message"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_send_pending()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
