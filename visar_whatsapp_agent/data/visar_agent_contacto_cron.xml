<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: el staff puede ajustar frecuencia/activo sin que un upgrade lo
         pise (mismo patron que el resto de crons de Visar). -->
    <data noupdate="1">
        <!-- Enlace tardio de contactos a clientes.
             Diario, de madrugada: el enlace se rehace YA en cada mensaje que
             entra, asi que esto solo recoge a quien escribio una vez y se hizo
             cliente DESPUES por otro canal (la web, o el mostrador) y por tanto
             ya no va a volver a disparar el enlace por su cuenta. Un dia de
             retraso en esa fila no le cuesta nada a nadie, y correrlo cada hora
             seria recorrer la tabla entera para no cambiar nada. -->
        <record id="visar_agent_contacto_cron" model="ir.cron">
            <field name="name">Visar: enlazar contactos de WhatsApp con su cliente</field>
            <field name="model_id" ref="model_visar_agent_contacto"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_resolver_partners()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=9, minute=20, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
