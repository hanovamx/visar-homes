<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Recordatorio de servicio (26-oct-2026): a quien le toca, oportunidad
             con actividad y WhatsApp. Cada hora, solo en horario de oficina
             (Ajustes → Visar); la idempotencia vive en el contacto. -->
        <record id="visar_recordatorio_cron" model="ir.cron">
            <field name="name">Visar: recordatorio de servicio a clientes sin suscripción</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_recordatorios()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="visar_wa_recordatorio_outbox_cron" model="ir.cron">
            <field name="name">Visar: recordatorios de servicio (buzón)</field>
            <field name="model_id" ref="model_visar_wa_recordatorio_message"/>
            <field name="state">code</field>
            <field name="code">model._visar_cron_send_pending()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
